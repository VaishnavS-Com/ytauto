# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored, so your secrets never reach GitHub.
# `.env.example` IS committed — it documents what settings exist.

# --- General ---
APP_ENV=development          # development | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# --- Channel identity (used from Phase 1 onward) ---
CHANNEL_NICHE=tech_ai_explainers
MAX_VIDEOS_PER_DAY=1

# --- Local LLM (Milestone 3) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b     # small enough for CPU-only laptops

# --- Voiceover (Milestone 5) ---
# Try also: en-US-GuyNeural, en-GB-RyanNeural, en-IN-NeerjaNeural
TTS_VOICE=en-US-AriaNeural

# --- API keys (added in later milestones; leave blank for now) ---
YOUTUBE_API_KEY=
