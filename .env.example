# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored, so your secrets never reach GitHub.
# `.env.example` IS committed — it documents what settings exist.

# --- General ---
APP_ENV=development          # development | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# --- Channel identity (used from Phase 1 onward) ---
CHANNEL_NICHE=tech_ai_explainers

# --- API keys (added in later milestones; leave blank for now) ---
YOUTUBE_API_KEY=
